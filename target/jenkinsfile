pipeline {
    agent any
 
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
 
        stage('Build and Test') {
            steps {
                bat 'mvn clean test'
            }
        }
    }
 
    post {
        always {
            archiveArtifacts(
                artifacts: 'target/surefire-reports/*,target/cucumber-report.html',
                allowEmptyArchive: true
            )
        }
 
        success {
            echo 'API automation tests passed'
        }
 
        failure {
            echo 'API automation tests failed'
        }
    }
}
